/* =============== CHAT ENGINE =============== */
var chatLog=$('chatLog'), chatStep='idle', chatIntent=null;
function addMsg(who,html){ var m=el('<div class="msg '+who+'"><div class="bubble">'+html+'</div></div>'); chatLog.appendChild(m); chatLog.scrollTop=chatLog.scrollHeight; return m; }
function botSay(html,cb){
  var t=el('<div class="msg bot"><div class="bubble typing"><i></i><i></i><i></i></div></div>');
  chatLog.appendChild(t); chatLog.scrollTop=chatLog.scrollHeight;
  setTimeout(function(){ t.remove(); addMsg('bot',html); if(cb)cb(); },600);
}
function addBtns(list){
  var w=el('<div class="msg bot"><div class="btns"></div></div>'), box=w.querySelector('.btns');
  list.forEach(function(b){
    var btn=el('<button type="button" class="chip">'+b.t+'</button>');
    btn.addEventListener('click',function(){
      var all=box.querySelectorAll('.chip'); for(var i=0;i<all.length;i++){ all[i].disabled=true; }
      btn.classList.add('picked');
      addMsg('user',esc(b.t));
      b.cb();
    });
    box.appendChild(btn);
  });
  chatLog.appendChild(w); chatLog.scrollTop=chatLog.scrollHeight;
}
function menuButtons(){
  addBtns([
    { t:'📦 Where\u2019s my order?', cb:function(){ routeIntent('order',''); } },
    { t:'↩️ Returns & refunds', cb:function(){ routeIntent('return',''); } },
    { t:'🏷️ Stock check', cb:function(){ routeIntent('stock',''); } },
    { t:'🙋 Human, please', cb:function(){ createTicket('general','chat request'); } }
  ]);
}
function orderButtons(){
  addBtns(Object.keys(ORDERS).map(function(id){ return { t:id, cb:function(){ if(chatIntent==='return'){ tryReturn(id); } else { tryOrder(id); } } }; }));
}
function routeIntent(intent,text){
  chatIntent=intent; MET.catVol[intent]=(MET.catVol[intent]||0)+1;
  if(intent==='order'){ chatStep='need_order'; if(extractId(text)) return tryOrder(text);
    botSay('Happy to help 📦 — what\u2019s the <b>order number</b>? It looks like <code>NS-1042</code>.'); }
  else if(intent==='return'){ chatStep='need_return'; if(extractId(text)) return tryReturn(text);
    botSay('Of course ↩️ — which <b>order</b> would you like to return or check a refund for?'); }
  else if(intent==='stock'){ chatStep='need_stock';
    if(findProduct(text)) return tryStock(text);
    botSay('Let me check the shelf 🏷️ — tell me the <b>product & size</b>, e.g. \u201cPulse Wireless Earbuds Black\u201d. You can also browse the full stock list under <b>Self-Serve</b>.'); }
}
function handleUser(text){
  lastUserText=text;
  addMsg('user',esc(text));
  var low=text.toLowerCase();
  if(/(human|agent|person|representative)/.test(low)){ createTicket(chatIntent||'general',text); return; }
  if(chatStep==='need_order') return tryOrder(text);
  if(chatStep==='need_return') return tryReturn(text);
  if(chatStep==='need_stock') return tryStock(text);
  var intent=detectIntent(low);
  if(!intent){ botSay('No problem — I can solve three things instantly. Pick one or just type it naturally:'); menuButtons(); return; }
  routeIntent(intent,text);
}
function csat(){
  addBtns([
    { t:'✅ Yes, that answered it', cb:function(){ MET.solved++; TREND.d[6]++; logInq('Chat',lastUserText,catLabel[chatIntent]||'General','Deflected','o-def'); renderMetrics(); toast('Deflected ✅ — no ticket created'); } },
    { t:'🙋 No, I need a human', cb:function(){ createTicket(chatIntent||'general',lastUserText); } }
  ]);
}
function createTicket(cat,ref){
  var t={ id:'T-'+(ticketSeq++), cust:'Chat visitor', subj:(catLabel[cat]||'General')+' · '+(ref||'chat'), body:'Escalated from Deflect chat with full context attached.', intent:cat||'unknown', conf:0.9, status:'new', src:'Chat' };
  tickets.unshift(t); MET.escalated++; TREND.e[6]++;
  logInq('Chat',lastUserText||ref,catLabel[cat]||'General','Escalated','o-esc');
  renderTickets(); renderMetrics();
  botSay('No problem — I\u2019ve opened <b>'+t.id+'</b> and attached everything I learned (intent: '+(catLabel[cat]||'General')+'). A teammate will pick it up shortly; watch your email for updates. 💙');
  chatStep='idle';
}
function tryOrder(text){
  var id=extractId(text);
  if(!id){ botSay('I couldn\u2019t find an order number there — tap one:'); orderButtons(); return; }
  if(!ORDERS[id]){ botSay('Hmm, <b>'+id+'</b> isn\u2019t in this demo dataset. Try:'); orderButtons(); return; }
  chatStep='idle';
  botSay('Found it! Here\u2019s the live picture for <b>'+id+'</b>:'+orderCardHTML(id), csat);
}
function tryReturn(text){
  var id=extractId(text);
  if(!id){ botSay('Which order? Tap one:'); orderButtons(); return; }
  if(!ORDERS[id]){ botSay('<b>'+id+'</b> isn\u2019t in this demo dataset. Try:'); orderButtons(); return; }
  chatStep='idle';
  if(RETURNS[id]){ botSay('You already have a return in motion ↩️:'+returnStatusHTML(id), csat); return; }
  var o=ORDERS[id];
  if(o.status!=='Delivered'){ botSay('Order <b>'+id+'</b> hasn\u2019t been delivered yet ('+o.status+'), so a return can\u2019t start until it arrives. Here\u2019s where it is:'+orderCardHTML(id), csat); return; }
  var days=Math.round((new Date('2025-06-05')-new Date(o.delivered))/86400000);
  if(days<=30){
    botSay('Good news — <b>'+id+'</b> is within our 30-day window:'+returnEligibleHTML(id), function(){
      addBtns([
        { t:'🖨️ Generate prepaid label', cb:function(){ MET.solved++; TREND.d[6]++; logInq('Chat',lastUserText,'Returns & refunds','Deflected','o-def'); renderMetrics(); toast('Deflected ✅ — return started, no ticket'); botSay('Done! A prepaid <b>QR label</b> is in your email 📬. Drop the parcel at any UPS point; refund lands 3–5 business days after the warehouse scan.'); } },
        { t:'🙋 Talk to a human', cb:function(){ createTicket('return',id); } }
      ]);
    });
  } else {
    botSay('Order <b>'+id+'</b> was delivered '+days+' days ago, past our 30-day window. I\u2019ve flagged it for a human to review options with you — we\u2019re committed to making it right.', function(){ createTicket('return',id); });
  }
}
function findProduct(t){
  var low=String(t).toLowerCase(), hit=null;
  PRODUCTS.forEach(function(p){
    if(low.indexOf(p.code.toLowerCase())>-1){ hit=p; return; }
    p.kw.forEach(function(k){ if(low.indexOf(k)>-1) hit=p; });
  });
  return hit;
}
function findSize(p,t){
  var low=String(t).toLowerCase(), hit=null;
  Object.keys(p.sizes).forEach(function(k){
    var rx=new RegExp('\\b'+k.toLowerCase().replace(/\s/g,'\\s?')+'\\b');
    if(rx.test(low)) hit=k;
  });
  return hit;
}
function tryStock(text){
  var p=findProduct(text);
  if(!p){ botSay('Which product? Tap one:'); addBtns(PRODUCTS.slice(0,4).map(function(pr){ return { t:pr.name, cb:function(){ showStock(pr,null); } }; })); return; }
  chatStep='idle';
  showStock(p,findSize(p,text));
}
function showStock(p,size){
  if(size && p.sizes[size]>0){
    botSay('Yes! <b>'+p.name+' · '+size+'</b> is <b>in stock</b> ('+p.sizes[size]+' available) — order now and it ships today 🎉'+stockCardHTML(p,size), csat);
  } else if(size && p.sizes[size]===0){
    botSay('Sorry — <b>'+p.name+' · '+size+'</b> is sold out right now. Restock ETA <b>'+(p.restock||'TBD')+'</b>:'+stockCardHTML(p,size), function(){
      addBtns([
        { t:'🔔 Notify me when it\u2019s back', cb:function(){ MET.notify++; MET.solved++; TREND.d[6]++; logInq('Chat',lastUserText,'Stock availability','Deflected (notify-me)','o-def'); renderMetrics(); toast('Deflected ✅ — notify-me signup, no ticket'); botSay('You\u2019re on the list! 🔔 We\u2019ll email you the moment <b>'+size+'</b> restocks (~'+(p.restock||'soon')+').'); } },
        { t:'🙋 Talk to a human', cb:function(){ createTicket('stock',p.name+' '+(size||'')); } }
      ]);
    });
  } else {
    botSay('Here\u2019s live availability for <b>'+p.name+'</b> ('+p.code+'):'+stockCardHTML(p,null), function(){
      addBtns(Object.keys(p.sizes).map(function(k){ return { t:k, cb:function(){ showStock(p,k); } }; }).concat([{ t:'🙋 Human', cb:function(){ createTicket('stock',p.name); } }]));
    });
  }
}

/* =============== SELF-SERVE =============== */
function ssPush(html){
  var area=$('ssResult');
  area.appendChild(el('<div class="result-card">'+html+'</div>'));
  area.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function ssTrack(){
  var id=extractId($('ssOrder').value||'');
  if(!id||!ORDERS[id]){ ssPush('<h3>⚠️ Order not found</h3><p style="font-size:13px;color:var(--mut)">Try a demo order: NS-1042 · NS-1177 · NS-0932 · NS-1290.</p>'); return; }
  logInq('Self-serve','Track '+id,'Order status','Answered','o-inf');
  ssPush('<h3>Tracking — '+id+'</h3>'+orderCardHTML(id));
}
function ssReturn(){
  var id=extractId($('ssOrder').value||'');
  if(!id||!ORDERS[id]){ ssPush('<h3>⚠️ Order not found</h3><p style="font-size:13px;color:var(--mut)">Try NS-0932 (live return) or NS-1042.</p>'); return; }
  logInq('Self-serve','Return '+id,'Returns & refunds','Answered','o-inf');
  if(RETURNS[id]) return ssPush('<h3>Return status — '+id+'</h3>'+returnStatusHTML(id));
  var o=ORDERS[id];
  if(o.status!=='Delivered') return ssPush('<h3>Return — '+id+'</h3><div class="ric"><div class="ric-note warn">Not delivered yet ('+o.status+'). Returns open after delivery. Current status:</div></div>'+orderCardHTML(id));
  ssPush('<h3>Return — '+id+'</h3>'+returnEligibleHTML(id)+'<p style="font-size:12px;color:var(--mut);margin-top:8px">In production this emails the QR label instantly via the returns-platform API.</p>');
}
function populateSizes(){
  var p=PRODUCTS[parseInt($('ssProduct').value,10)], s=$('ssSize');
  s.innerHTML=Object.keys(p.sizes).map(function(k){ return '<option>'+k+'</option>'; }).join('');
}
function ssStock(){
  var p=PRODUCTS[parseInt($('ssProduct').value,10)], size=$('ssSize').value, n=p.sizes[size], extra='';
  if(n===0 && $('ssNotify').checked){ MET.notify++; renderMetrics(); toast('🔔 Notify-me saved for '+p.name+' · '+size); extra='<div class="ric-note">🔔 You\u2019re on the restock list for '+size+'.</div>'; }
  logInq('Self-serve','Stock '+p.name+' '+size,'Stock availability', n>0?'Answered':'Notify-me','o-inf');
  ssPush('<h3>Availability — '+p.name+'</h3>'+stockCardHTML(p,size)+extra);
}
function renderTiles(filter){
  var g=$('tileGrid'); g.innerHTML='';
  var f=(filter||'').toLowerCase(), shown=0;
  PRODUCTS.forEach(function(p,idx){
    if(f && (p.name+' '+p.code+' '+p.cat).toLowerCase().indexOf(f)===-1) return;
    shown++;
    var total=0,out=0; Object.keys(p.sizes).forEach(function(k){ total+=p.sizes[k]; if(p.sizes[k]===0) out++; });
    var avail=(out===Object.keys(p.sizes).length)?'All variants out':(total+' in stock');
    var t=el('<button type="button" class="ptile"><div class="pt-top"><b>'+p.name+'</b><span class="pt-code">'+p.code+'</span></div><div class="pt-cat">'+p.cat+' · '+avail+'</div><div class="pt-sizes">'+Object.keys(p.sizes).map(function(k){ return '<span class="sz '+(p.sizes[k]>0?'ok':'out')+'">'+k+'</span>'; }).join('')+'</div></button>');
    t.addEventListener('click',function(){
      $('ssProduct').value=String(idx); populateSizes();
      var all=g.querySelectorAll('.ptile'); for(var i=0;i<all.length;i++){ all[i].classList.remove('sel'); }
      t.classList.add('sel');
      toast('Selected '+p.name+' — pick a size & check ✓');
    });
    g.appendChild(t);
  });
  if(!shown) g.innerHTML='<div class="empty-small">No products match \u201c'+esc(filter||'')+'\u201d — try \u201cearbuds\u201d, \u201cjacket\u201d or a code like NSR-30254.</div>';
}

/* =============== AGENT CONSOLE =============== */
function renderTickets(){
  var list=$('ticketList'); list.innerHTML='';
  tickets.forEach(function(t){
    var c=INTC[t.intent]||'#64748b';
    var row=el('<div class="ticket">'+
      '<div class="tk-top"><span class="tk-id">'+t.id+' · '+t.cust+' · '+t.src+'</span>'+
      '<span class="tk-tag" style="color:'+c+'">● '+catLabel[t.intent]+'</span>'+
      '<span class="confbar" title="classifier confidence"><i style="width:'+Math.round(t.conf*100)+'%;background:'+c+'"></i></span>'+
      '<span style="font-size:11px;color:var(--mut)">'+Math.round(t.conf*100)+'%</span></div>'+
      '<div class="tk-subj">'+esc(t.subj)+'</div>'+
      '<div class="tk-body">'+esc(t.body||'')+'</div>'+
      '<div class="tk-actions">'+
        (t.status==='new'
          ? '<span class="tk-sugg">🤖 Suggested: '+(SUGG[t.intent]||'—')+'</span>'+
            (t.conf>=0.85?'<button type="button" class="btn acc" data-act="auto" data-id="'+t.id+'">⚡ Auto-resolve &amp; send</button>':'')+
            '<button type="button" class="btn ghost" data-act="manual" data-id="'+t.id+'">✋ Take manually</button>'
          : '<span class="st '+t.status+'">'+(t.status==='auto'?'AUTO-RESOLVED ✅':'MANUAL 👤')+'</span>')+
      '</div></div>');
    list.appendChild(row);
  });
  var btns=list.querySelectorAll('button[data-act]');
  for(var i=0;i<btns.length;i++){
    (function(b){
      b.addEventListener('click',function(){
        var id=b.getAttribute('data-id'), tk=null;
        for(var j=0;j<tickets.length;j++){ if(tickets[j].id===id) tk=tickets[j]; }
        if(!tk) return;
        if(b.getAttribute('data-act')==='auto'){ tk.status='auto'; MET.auto++; TREND.d[6]++; logInq('Triage',tk.subj,catLabel[tk.intent],'Auto-resolved','o-def'); toast('⚡ '+tk.id+' auto-resolved with drafted reply'); }
        else { tk.status='manual'; MET.manual++; TREND.e[6]++; logInq('Triage',tk.subj,catLabel[tk.intent],'Manual','o-esc'); }
        renderTickets(); renderMetrics();
      });
    })(btns[i]);
  }
  $('agNew').textContent=tickets.filter(function(t){ return t.status==='new'; }).length;
  $('agAuto').textContent=MET.auto;
  $('agMan').textContent=MET.manual;
}

